# Salin file ini menjadi .env, lalu isi API key Anda.
# Dapatkan API key di: https://aistudio.google.com/apikey
# PENTING: jangan pernah commit file .env ke git.
GEMINI_API_KEY=GANTI_DENGAN_API_KEY_ANDA

# ==== Resend (opsional - untuk kirim notulen via email) ====
# Buat API key di: https://resend.com/api-keys
RESEND_API_KEY=
# Alamat pengirim email. Wajib domain terverifikasi untuk kirim ke siapa pun.
# Default 'onboarding@resend.dev' hanya bisa mengirim ke email akun Anda sendiri.
RESEND_PENGIRIM=onboarding@resend.dev
