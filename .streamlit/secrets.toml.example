# Template SECRETS Streamlit — salin menjadi .streamlit/secrets.toml
# lalu isi nilai aslinya. File secrets.toml TIDAK pernah di-commit
# (sudah dilindungi .gitignore).
#
# CATATAN FORMAT: Streamlit memakai format TOML (ada tanda kutip dan "="),
# jadi beda dari file .env. Di Streamlit Community Cloud Anda menempelkan
# isi persis seperti ini ke dashboard: App menu -> Settings -> Secrets.

#-butuh: kunci API Gemini (aistudio.google.com/apikey)
GEMINI_API_KEY = "ISI_API_KEY_ANDA"

# opsional: kirim notulen via email (Resend)
RESEND_API_KEY = ""
RESEND_PENGIRIM = "onboarding@resend.dev"
